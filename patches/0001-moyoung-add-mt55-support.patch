+package nodomain.freeyourgadget.gadgetbridge.devices.moyoung;
+
+import androidx.annotation.DrawableRes;
+import androidx.annotation.NonNull;
+
+import java.util.regex.Pattern;
+
+import nodomain.freeyourgadget.gadgetbridge.R;
+import nodomain.freeyourgadget.gadgetbridge.impl.GBDevice;
+
+/**
+ * MT55 - a MOYOUNG-V2 watch sold unbranded / under various names.
+ *
+ * Device identification confirmed over GATT:
+ *   Manufacturer (0x2A29) = "MOYOUNG-V2"   -> V2 protocol, MTU-based framing
+ *   Software rev (0x2A28) = "MOY-JSB2-2.0.4"
+ *   Firmware rev (0x2A26) = "JLQFNJEJ1.1"
+ *   Advertised service    = 0xFEEA, with FEE1/FEE2/FEE3/FEE5/FEE6 present
+ *
+ * Note: the ECG characteristics (FEE7/FEE8 of service 0xFEEA) are NOT present on
+ * this watch, and Model Number (0x2A24) is absent from the Device Information
+ * Service, so the "DFU status" probe cannot resolve.
+ */
+public class MT55Coordinator extends AbstractMoyoungDeviceCoordinator {
+    @Override
+    protected Pattern getSupportedDeviceName() {
+        return Pattern.compile("^MT55$");
+    }
+
+    @Override
+    public int getDeviceNameResource() {
+        return R.string.devicetype_mt55;
+    }
+
+    @Override
+    @DrawableRes
+    public int getDefaultIconResource() {
+        return R.drawable.ic_device_banglejs;
+    }
+
+    @Override
+    public String getManufacturer() {
+        return "Mo Young / Da Fit";
+    }
+
+    @Override
+    public int getMtu() {
+        // MOYOUNG-V2 -> MTU-based framing, as for the other V2 watches.
+        return 508;
+    }
+
+    // --- Capability flags -------------------------------------------------
+    // Verified on hardware: battery (0x2A19) and the 9-byte pedometer payload
+    // on FEE1 both decode correctly. The flags below follow the other
+    // MOYOUNG-V2 coordinators and still need per-feature confirmation on this
+    // model; see docs/MT55_VERIFICATION.md in the OpenWatch repository.
+
+    @Override
+    public int getAlarmSlotCount(GBDevice device) {
+        return 8;
+    }
+
+    @Override
+    public int getWorldClocksSlotCount() {
+        return 6;
+    }
+
+    @Override
+    public int getWorldClocksLabelLength() {
+        return 30;
+    }
+
+    @Override
+    public boolean supportsRemSleep(@NonNull GBDevice device) {
+        return true;
+    }
+
+    @Override
+    public boolean supportsStressMeasurement(@NonNull GBDevice device) {
+        return true;
+    }
+
+    // Unlike most MOYOUNG-V2 coordinators (but like L70), enable heart rate
+    // streaming and history. supportsHeartRateHistory() gates whether HR data is
+    // requested at all in FetchDataOperation, and supportsHeartRateStreaming()
+    // gates live measurement in MoyoungDeviceSupport.
+    @Override
+    public boolean supportsHeartRateStreaming() {
+        return true;
+    }
+
+    @Override
+    public boolean supportsHeartRateHistory() {
+        return true;
+    }
+}
