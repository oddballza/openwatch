 .../gadgetbridge/model/DeviceType.java        |   2 +
 app/src/main/res/values/strings.xml           |   1 +
 3 files changed, 115 insertions(+)
 create mode 100644 app/src/main/java/nodomain/freeyourgadget/gadgetbridge/devices/moyoung/MT55Coordinator.java

